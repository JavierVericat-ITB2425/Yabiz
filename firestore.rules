rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo TU cuenta puede leer y escribir, y solo sus propios datos.
    // Al pegar estas reglas en la consola de Firebase, cambia TU_EMAIL por el email con el que entras en Yabiz
    // (así tu email no queda publicado en GitHub).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.token.email == 'TU_EMAIL';
    }
  }
}
